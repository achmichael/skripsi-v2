{
  "version": 2,
  "builds": [
    {
      "src": "backend/app/api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/app/api/index.py"
    }
  ],
  "functions": {
    "backend/app/api/index.py": {
      "includeFiles": "results/**/*.json",
      "maxDuration": 10
    }
  }
}
